<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>tạo ra</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --background-color: #FFFBF0;
            --card-background: #FFFFFF;
            --text-color: #4A4A4A;
            --primary-accent: #D98D42;
            --secondary-text: #888;
            --border-color: #F0EAD6;
            --shadow-color: rgba(0, 0, 0, 0.05);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        /* Header */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .header-title {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .header-title .icon {
            font-size: 1.5rem;
            background-color: var(--card-background);
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--primary-accent);
        }

        .header-title h1 {
            font-size: 1.75rem;
            font-weight: 700;
        }

        .header-title p {
            font-size: 0.9rem;
            color: var(--secondary-text);
        }
        
        .header-actions {
            display: flex;
            gap: 1.5rem;
            font-size: 1.2rem;
            color: var(--secondary-text);
        }

        .header-actions i:hover {
            color: var(--text-color);
            cursor: pointer;
        }

        /* Main Layout */
        main {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 2rem;
        }

        .left-column {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        /* General Card Style */
        .card {
            background-color: var(--card-background);
            padding: 1.5rem;
            border-radius: 16px;
            box-shadow: 0 4px 15px var(--shadow-color);
        }

        /* Next Exam Card */
        .next-exam {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .next-exam .icon {
            font-size: 1.2rem;
            color: var(--primary-accent);
        }

        .next-exam-info h2 {
            font-size: 0.8rem;
            text-transform: uppercase;
            font-weight: 600;
            color: var(--secondary-text);
        }
        
        .next-exam-info .subject {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .next-exam-info .date {
            background-color: #FDF5E9;
            padding: 0.2rem 0.6rem;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--primary-accent);
            display: inline-block;
            margin-left: 0.5rem;
        }

        /* Countdown Section */
        .countdown-title {
            font-size: 1.1rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
        }

        .timer {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;
            text-align: center;
        }
        
        .time-block {
            background-color: var(--card-background);
            padding: 1.5rem 1rem;
            border-radius: 16px;
            box-shadow: 0 4px 15px var(--shadow-color);
        }

        .time-block .number {
            display: block;
            font-size: 4rem;
            font-weight: 700;
            line-height: 1.1;
        }

        .time-block .label {
            font-size: 0.8rem;
            text-transform: uppercase;
            color: var(--secondary-text);
            font-weight: 500;
        }
        
        /* Quote Section */
        .quote {
            text-align: center;
            padding: 1rem 0;
        }
        
        .quote blockquote {
            font-size: 1.1rem;
            font-style: italic;
            margin-bottom: 0.5rem;
            border: none;
        }
        
        .quote cite {
            font-size: 0.9rem;
            color: var(--secondary-text);
        }

        /* Progress Card */
        .progress .progress-bar-container {
            width: 100%;
            background-color: #F3F3F3;
            border-radius: 20px;
            height: 12px;
            overflow: hidden;
            margin: 0.5rem 0;
            position: relative;
        }
        
        .progress .progress-bar-fill {
            width: 17.8%;
            height: 100%;
            background: linear-gradient(90deg, #FDB84B, var(--primary-accent));
            border-radius: 20px;
        }

        .progress .card-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.5rem;
        }

        .progress .card-title h3 {
            font-size: 1.2rem;
            font-weight: 600;
        }

        .progress .percentage {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--primary-accent);
        }

        .progress p {
            font-size: 0.9rem;
            color: var(--secondary-text);
        }

        /* Message Card */
        .message .card-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.5rem;
        }
        
        .message .icon {
            font-size: 1rem;
            background-color: #FEF3E4;
            color: var(--primary-accent);
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .message h3 {
            font-size: 1.2rem;
            font-weight: 600;
        }

        /* Right Column - Schedule */
        .schedule .card-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .schedule h3 {
            font-size: 1.2rem;
            font-weight: 600;
        }

        .exam-list {
            list-style: none;
        }
        
        .exam-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem;
            border-radius: 12px;
            margin-bottom: 0.5rem;
            transition: background-color 0.2s;
        }

        .exam-item.active {
            background-color: #FFF7E8;
            border: 1px solid var(--border-color);
        }

        .exam-item .icon {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            flex-shrink: 0;
        }

        .exam-item.ngu-van .icon { background-color: #FEF3E4; color: #D98D42; }
        .exam-item.toan .icon { background-color: #EBF5FF; color: #3A99F7; }
        .exam-item.tu-chon-1 .icon { background-color: #F0F0F0; color: #6C757D; }
        .exam-item.tu-chon-2 .icon { background-color: #F0F0F0; color: #6C757D; }
        
        .exam-details {
            flex-grow: 1;
        }
        
        .exam-details .subject-name {
            font-weight: 600;
        }
        
        .exam-details .info {
            font-size: 0.85rem;
            color: var(--secondary-text);
        }
        
        .exam-item .status {
            background-color: var(--primary-accent);
            color: white;
            padding: 0.2rem 0.8rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 500;
            white-space: nowrap;
        }

        /* Footer */
        footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 2rem;
            max-width: 1200px;
            margin: 2rem auto 0;
            border-top: 1px solid var(--border-color);
            font-size: 0.9rem;
            color: var(--secondary-text);
        }

        .support {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
        }
        .support:hover {
            color: var(--primary-accent);
        }

        /* Responsive */
        @media (max-width: 992px) {
            main {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }
            .timer {
                grid-template-columns: repeat(2, 1fr);
            }
            .time-block .number {
                font-size: 3rem;
            }
            header {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }
            footer {
                flex-direction: column;
                gap: 1rem;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <div class="header-title">
                <div class="icon"><i class="fa-regular fa-calendar-days"></i></div>
                <div>
                    <h1>tạo ra</h1>
                    <p>Trang web đếm ngược ngày thi THPT 2027</p>
                </div>
            </div>
            <div class="header-actions">
                <i class="fa-solid fa-filter"></i>
                <i class="fa-solid fa-share-nodes"></i>
                <i class="fa-solid fa-sliders"></i>
            </div>
        </header>

        <main>
            <div class="left-column">
                <div class="card next-exam">
                    <div class="icon"><i class="fa-regular fa-clock"></i></div>
                    <div class="next-exam-info">
                        <h2>MÔN THI TIẾP THEO</h2>
                        <span class="subject">Ngữ văn</span>
                        <span class="date">11/6/2027 - 07:30</span>
                    </div>
                </div>

                <section class="countdown">
                    <h3 class="countdown-title">Thời gian còn lại đến môn thi Ngữ văn</h3>
                    <div class="timer">
                        <div class="time-block">
                            <span class="number">229</span>
                            <span class="label">Ngày</span>
                        </div>
                        <div class="time-block">
                            <span class="number">13</span>
                            <span class="label">Giờ</span>
                        </div>
                        <div class="time-block">
                            <span class="number">40</span>
                            <span class="label">Phút</span>
                        </div>
                        <div class="time-block">
                            <span class="number">19</span>
                            <span class="label">Giây</span>
                        </div>
                    </div>
                </section>

                <section class="quote">
                    <blockquote>“Tương lai thuộc về những người tin vào vẻ đẹp của ước mơ”</blockquote>
                    <cite>Eleanor Roosevelt. The future belongs to those who believe in the beauty of their dreams</cite>
                </section>

                <section class="card progress">
                    <div class="card-title">
                        <h3>Tiến trình</h3>
                        <span class="percentage">17.8%</span>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-bar-fill"></div>
                    </div>
                    <p>17.8% thời gian đã qua từ đầu năm học (05/09/2026) đến kỳ thi THPT 2027</p>
                </section>

                <section class="card message">
                    <div class="card-title">
                        <div class="icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
                        <h3>Đôi lời nhắn nhủ đến bạn</h3>
                    </div>
                    <p>Nghỉ ngơi đúng lúc cũng là một phần của việc học hiệu quả.</p>
                </section>
            </div>

            <aside class="right-column">
                <div class="card schedule">
                    <div class="card-title">
                        <i class="fa-regular fa-calendar"></i>
                        <h3>Lịch thi tổng quan 2027 (Dự kiến)</h3>
                    </div>
                    <ul class="exam-list">
                        <li class="exam-item active ngu-van">
                            <div class="icon"><i class="fa-regular fa-pen-to-square"></i></div>
                            <div class="exam-details">
                                <div class="subject-name">Ngữ văn</div>
                                <div class="info">11/6/2027 | 07:30 | 120 phút</div>
                            </div>
                            <span class="status">Đang đếm ngược</span>
                        </li>
                        <li class="exam-item toan">
                            <div class="icon"><i class="fa-solid fa-calculator"></i></div>
                            <div class="exam-details">
                                <div class="subject-name">Toán</div>
                                <div class="info">11/6/2027 | 14:20 | 90 phút</div>
                            </div>
                        </li>
                        <li class="exam-item tu-chon-1">
                            <div class="icon"><strong>1</strong></div>
                            <div class="exam-details">
                                <div class="subject-name">Bài thi Tự chọn môn thứ nhất</div>
                                <div class="info">12/6/2027 | 07:30 | 50 phút</div>
                            </div>
                        </li>
                        <li class="exam-item tu-chon-2">
                            <div class="icon"><strong>2</strong></div>
                            <div class="exam-details">
                                <div class="subject-name">Bài thi Tự chọn môn thứ hai</div>
                                <div class="info">12/6/2027 | 08:35 | 50 phút</div>
                            </div>
                        </li>
                    </ul>
                </div>
            </aside>
        </main>
    </div>

    <footer>
        <div class="copyright">@2027 - @anhkhoatqt11</div>
        <div class="support">
            <i class="fa-regular fa-heart"></i>
            <span>Ủng hộ</span>
        </div>
    </footer>

</body>
</html>
